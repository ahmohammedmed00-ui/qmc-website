{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "README.txt", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(webp|png|jpg|mp4)", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
